# Copy to .env and fill in. .env is gitignored and must stay that way.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# True only behind a trusted nginx TLS proxy (preserves secure session/CSRF cookies).
DJANGO_BEHIND_PROXY=False

DB_NAME=varna_market
DB_USER=gabe
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Legacy crawler compatibility; public search uses City/OfferGeo, not this setting.
MARKET_CITY=Варна

# See docs/CRAWL-POLICY.md before changing any of these.
CRAWL_RESPECT_ROBOTS=False
CRAWL_WORKERS=4
CRAWL_HOST_DELAY=2.0
CRAWL_BACKOFF_LIMIT=3
CRAWL_TIMEOUT=90
